# Required: OpenAI API key for GPT-4o-mini analysis
OPENAI_API_KEY=sk-proj-...

# Required: Discord Bot token for posting to #x-alerts channel
# Use the main OpenClaw bot token (has access to #x-alerts channel 1477727527618347340)
DISCORD_BOT_TOKEN=MTQ3NjY3NTcx...

# Optional: Override config path (default: ./config.json)
# X_ENGAGE_CONFIG=./config.json

# Optional: managed Social OS runtime source (default production path)
# SOCIAL_OS_SUPABASE_URL=https://your-project.supabase.co
# SOCIAL_OS_SUPABASE_KEY=...
# or: SOCIAL_OS_SUPABASE_ANON_KEY=...
# Optional test/emergency override:
# X_ENGAGE_RUNTIME_PATH=./runtime.json
# Optional root for logical session ids from session_mappings (default: ~/.x-engage-browser)
# X_ENGAGE_BROWSER_PROFILE_ROOT=~/.x-engage-browser
